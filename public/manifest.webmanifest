{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ECNS - Ethereum Classic Name Service",
  "short_name": "ECNS",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "orientation": "portrait-primary",
  "theme_color": "#3FB68B",
  "background_color": "#1A3A2E",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "description": "Decentralized naming for Ethereum Classic. Claim your .etc domain.",
  "categories": ["blockchain", "crypto", "web3", "utilities"],
  "lang": "en-US",
  "dir": "ltr",
  "id": "ecns-domains",
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "label": "ECNS Homepage"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
